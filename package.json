{
  "name": "antigravity-slash-helper",
  "displayName": "Antigravity Slash Helper",
  "description": "Google Antigravity IDE 核心斜杠命令选择菜单、自动扫描与健康度管理助手",
  "version": "1.0.0",
  "publisher": "antigravity-community",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "antigravity",
    "slash",
    "commands",
    "chat",
    "skills"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.slash.openPalette",
        "title": "Antigravity: 打开斜杠命令选择菜单",
        "icon": "$(zap)"
      },
      {
        "command": "antigravity.slash.scanAll",
        "title": "Antigravity: 重新扫描全局与项目斜杠命令",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity.slash.checkHealth",
        "title": "Antigravity: 检查命令健康度与物理依赖",
        "icon": "$(heart)"
      },
      {
        "command": "antigravity.slash.cleanInvalid",
        "title": "Antigravity: 一键清理所有失效斜杠命令",
        "icon": "$(trash)"
      },
      {
        "command": "antigravity.slash.addCustom",
        "title": "Antigravity: 手动添加自定义斜杠命令",
        "icon": "$(add)"
      },
      {
        "command": "antigravity.slash.deleteCommand",
        "title": "Antigravity: 删除此命令",
        "icon": "$(close)"
      },
      {
        "command": "antigravity.slash.insertToChat",
        "title": "Antigravity: 填入 Chat 输入框",
        "icon": "$(comment)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity.slash.openPalette",
        "key": "alt+/",
        "mac": "cmd+/"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-slash-container",
          "title": "Antigravity 命令助手",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "antigravity-slash-container": [
        {
          "id": "antigravity-slash-commands-view",
          "name": "斜杠命令管理中心"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "antigravity.slash.openPalette",
          "when": "view == antigravity-slash-commands-view",
          "group": "navigation@1"
        },
        {
          "command": "antigravity.slash.scanAll",
          "when": "view == antigravity-slash-commands-view",
          "group": "navigation@2"
        },
        {
          "command": "antigravity.slash.cleanInvalid",
          "when": "view == antigravity-slash-commands-view",
          "group": "navigation@3"
        },
        {
          "command": "antigravity.slash.addCustom",
          "when": "view == antigravity-slash-commands-view",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "antigravity.slash.insertToChat",
          "when": "view == antigravity-slash-commands-view && viewItem == slashCommandItem",
          "group": "inline@1"
        },
        {
          "command": "antigravity.slash.deleteCommand",
          "when": "view == antigravity-slash-commands-view && viewItem == slashCommandItem",
          "group": "9_danger@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/unit.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}

